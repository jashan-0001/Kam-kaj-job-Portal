import streamlit as st
import pandas as pd

from services.job_service import (
    get_jobs_by_employer,
    get_job_by_id,
    update_job,
    delete_job
)
from services.audit_service import log_activity
from utils.logger import logger



def show_job_management(user_id):


    st.subheader(
        "📋 My Posted Jobs"
    )


    try:


        jobs = get_jobs_by_employer(
            user_id
        )


        if not jobs:

            st.info(
                "No jobs have been posted yet."
            )

            return



        # -----------------------------------
        # Search
        # -----------------------------------

        search = st.text_input(
            "🔍 Search Job",
            placeholder="Search by title or company..."
        ).strip().lower()



        filtered_jobs = []


        for job in jobs:


            title = job["title"].lower()

            company = job["company"].lower()



            if (
                search in title
                or
                search in company
            ):

                filtered_jobs.append(job)



        if not filtered_jobs:


            st.warning(
                "No matching jobs found."
            )

            return



        # -----------------------------------
        # Data Table
        # -----------------------------------

        table = []


        for job in filtered_jobs:


            table.append(
                {

                    "ID": job["id"],

                    "Title": job["title"],

                    "Company": job["company"],

                    "Location": job["location"],

                    "Experience": job["experience"],

                    "Salary": job["salary"],

                    "Status": job["status"]

                }
            )



        df = pd.DataFrame(
            table
        )


        st.dataframe(

            df,

            use_container_width=True,

            hide_index=True

        )



        st.divider()
# =====================================================
# EDIT JOB
# =====================================================

st.divider()

st.subheader(
    "✏ Edit Job"
)

selected_job_id = st.selectbox(

    "Select Job to Edit",

    options=df["ID"].tolist(),

    key="edit_job",

    format_func=lambda x:
        next(
            (
                f"{job['title']} ({job['company']})"
                for job in filtered_jobs
                if job["id"] == x
            ),
            str(x)
        )
)

job = get_job_by_id(
    selected_job_id
)

if job:

    with st.form(
        "edit_job_form"
    ):

        title = st.text_input(
            "Job Title",
            value=job["title"]
        )

        company = st.text_input(
            "Company",
            value=job["company"]
        )

        location = st.text_input(
            "Location",
            value=job["location"]
        )

        experience = st.selectbox(

            "Experience",

            [

                "Fresher",

                "0-1 Years",

                "1-3 Years",

                "3-5 Years",

                "5+ Years"

            ],

            index=[

                "Fresher",

                "0-1 Years",

                "1-3 Years",

                "3-5 Years",

                "5+ Years"

            ].index(job["experience"])

            if job["experience"] in [

                "Fresher",

                "0-1 Years",

                "1-3 Years",

                "3-5 Years",

                "5+ Years"

            ]

            else 0

        )

        salary = st.text_input(
            "Salary",
            value=job["salary"]
        )

        skills = st.text_area(
            "Skills",
            value=job["skills"],
            height=120
        )

        description = st.text_area(
            "Description",
            value=job["description"],
            height=220
        )

        update = st.form_submit_button(
            "💾 Update Job",
            use_container_width=True
        )

    if update:

        success = update_job(

            selected_job_id,

            title.strip(),

            company.strip(),

            location.strip(),

            experience,

            salary.strip(),

            skills.strip(),

            description.strip()

        )

        if success:

            log_activity(

                user_id=user_id,

                action="JOB_UPDATE",

                description=f"Updated job: {title}"

            )

            st.success(
                "Job updated successfully."
            )

            st.rerun()

        else:

            st.error(
                "Unable to update job."
            )


        # -----------------------------------
        # Delete Job
        # -----------------------------------

        st.subheader(
            "🗑 Delete Job"
        )



        selected_job = st.selectbox(

            "Select Job",

            options=df["ID"].tolist(),

            format_func=lambda x:

                next(

                    (

                        f"{job['title']} ({job['company']})"

                        for job in filtered_jobs

                        if job["id"] == x

                    ),

                    str(x)

                )

        )



        if st.button(

            "Delete Selected Job",

            type="primary",

            use_container_width=True

        ):



            try:


                # Find job details before deletion

                selected_job_details = next(

                    (

                        job

                        for job in filtered_jobs

                        if job["id"] == selected_job

                    ),

                    None

                )



                success = delete_job(
                    selected_job
                )



                if success:



                    logger.info(

                        f"Job ID={selected_job} deleted by Employer ID={user_id}"

                    )



                    # =============================
                    # AUDIT LOG
                    # =============================

                    log_activity(

                        user_id=user_id,

                        action="JOB_DELETE",

                        description=(

                            f"Deleted job: "
                            f"{selected_job_details['title']}"
                            if selected_job_details
                            else
                            f"Deleted job ID {selected_job}"

                        )

                    )



                    st.success(

                        "Job deleted successfully."

                    )


                    st.rerun()



                else:



                    logger.warning(

                        f"Failed deleting Job ID={selected_job}"

                    )


                    st.error(

                        "Unable to delete the job."

                    )



            except Exception:


                logger.exception(

                    "Unexpected error while deleting job."

                )


                st.error(

                    "Something went wrong while deleting job."

                )



    except Exception:


        logger.exception(

            "Unexpected error loading job management."

        )


        st.error(

            "Unable to load job management."

        )